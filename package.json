{
  "name": "legacy-fighters",
  "version": "1.81.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:api": "wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.cjs",
    "dev": "python3 -m http.server 8080 --bind 127.0.0.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.147.0"
  }
}
